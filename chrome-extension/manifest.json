{
  "manifest_version": 3,
  "name": "Zero-Click CRM Assistant",
  "version": "1.0",
  "description": "AI that listens to meetings and organizes CRM data automatically.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup.js"]
    }
  ]
}
