{
  "name": "autonomous-deal-tracker",
  "version": "1.0.0",
  "description": "Autonomous Deal Tracker Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/server.js",
    "dev": "npx ts-node-dev --respawn --transpile-only src/server.ts",
    "watch": "npx tsc --watch",
    "test": "npx ts-node src/test/testRunner.ts",
    "test:integration": "npx ts-node src/test/integration.test.ts",
    "test:unit": "npx ts-node src/test/unit.test.ts",
    "test:stress": "npx ts-node src/test/stress.test.ts",
    "test:all": "npm test && npm run test:unit && npm run test:integration && npm run test:stress"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "googleapis": "^129.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
